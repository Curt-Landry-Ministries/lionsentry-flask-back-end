# Base image
FROM python:3.8-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    python3-dev \
    # any other dependencies you might need
    && rm -rf /var/lib/apt/lists/*

# Set the working directory to /app/backend
WORKDIR /app/backend

# Copy the requirements.txt file into the container
COPY ./requirements.txt /app/backend/

# Upgrade pip and install dependencies
RUN pip install --upgrade pip && \
    pip install -r /app/backend/requirements.txt && \
    pip install pytest flask_testing

# Bundle the entire backend source
COPY ./backend /app/backend

# Set the PYTHONPATH environment variable
ENV PYTHONPATH /app/

# Command to list all tests and then run them using pytest
CMD find /app/backend/tests -name 'test_*.py' -print && pytest /app/backend/tests/ 
